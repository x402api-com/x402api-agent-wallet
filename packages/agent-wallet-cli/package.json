{
  "name": "@x402api/agent-wallet-cli",
  "version": "0.1.0",
  "description": "Command-line wallet for autonomous x402 purchases.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "x402api": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "types": "./dist/cli.d.ts",
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@x402api/agent-wallet-core": "0.1.0"
  }
}
