{
  "name": "@x402api/agent-wallet-cli",
  "version": "0.2.7",
  "description": "Command-line wallet for autonomous x402 purchases.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x402api-com/x402api-agent-wallet.git",
    "directory": "packages/agent-wallet-cli"
  },
  "homepage": "https://github.com/x402api-com/x402api-agent-wallet#readme",
  "bugs": "https://github.com/x402api-com/x402api-agent-wallet/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "skill"
  ],
  "bin": {
    "x402api": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "types": "./dist/cli.d.ts",
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../tools/copy-skill.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@x402api/agent-wallet-core": "0.2.7"
  }
}
